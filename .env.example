# Copy to .env.local and fill values locally.
# Never commit real Contentful IDs or tokens.

CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT_ID=dev
CONTENTFUL_DEFAULT_LOCALE=

CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# Verification uses a freshly recreated dev environment.
# No persistent verification environment is used.
CONTENTFUL_MODEL_SNAPSHOT=contentful-model.current.json
