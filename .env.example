# Never commit a real management token.

CONTENTFUL_SPACE_ID=
CONTENTFUL_MANAGEMENT_TOKEN=

# Source environment for migration and export.
CONTENTFUL_ENVIRONMENT_ID=dev

# Clean environment used to verify the model-only import.
CONTENTFUL_TARGET_ENVIRONMENT_ID=verification

# Output filename written inside content-model/snapshots.
CONTENTFUL_MODEL_SNAPSHOT=contentful-model.current.json
